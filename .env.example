# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=""

NEXTAUTH_JWT_SECRET=""
NEXTAUTH_SECRET=""

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# LINE Pay (https://pay.line.me/developers/) -- sign up for a free
# Sandbox merchant account to get a Channel ID/Secret for testing.
# LINE_PAY_ENV should be "sandbox" (default) or "production".
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_ENV="sandbox"

# Must be reachable by the browser (not the server) -- LINE Pay redirects
# the user's browser back here after checkout. localhost is fine for
# local development since it's the same machine the user is testing on.
# Also used to build absolute links in notification emails below.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend (https://resend.com) -- free tier, no domain verification
# needed to start (the default RESEND_FROM_EMAIL below works
# out of the box, but can only send to the email you signed up
# with until you verify your own sending domain). Powers the email
# half of in-app notifications; without it, notifications still work
# in-app, they just don't also email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GearShare <onboarding@resend.dev>"
