// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  favoriteIds     String[] @db.ObjectId

  accounts Account[]
  gear     Gear[]
  rentals  Rental[]
}

model Account {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// A single piece of gear one user is offering to rent out to others.
model Gear {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  imageSrc      String
  createdAt     DateTime @default(now())
  category      String
  condition     String
  depositAmount Int
  pricePerDay   Int
  locationValue String
  userId        String @db.ObjectId

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentals Rental[]
}

// A booked date range for a piece of gear, plus the deposit/condition
// lifecycle for that specific rental.
model Rental {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String @db.ObjectId
  gearId          String @db.ObjectId
  startDate       DateTime
  endDate         DateTime
  totalPrice      Int
  depositStatus   String @default("held") // held | refunded | forfeited
  returnCondition String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear Gear @relation(fields: [gearId], references: [id], onDelete: Cascade)
}
